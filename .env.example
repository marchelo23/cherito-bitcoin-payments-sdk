NODE_ENV=development
PORT=3100
HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Lightning provider — LND (BOLT11)
# ---------------------------------------------------------------------------
LIGHTNING_PROVIDER=lnd
LND_REST_URL=https://umbrel.local:8080

# Choose ONE of: file path (preferred) OR base64/hex inline value
LND_TLS_CERT_PATH=/run/secrets/lnd-tls.cert
LND_MACAROON_PATH=/run/secrets/cherito-invoice.macaroon
LND_TLS_CERT_BASE64=
LND_MACAROON_HEX=

# ---------------------------------------------------------------------------
# BOLT12 experimental support (optional, via LNDK)
# ---------------------------------------------------------------------------
BOLT12_PROVIDER=none
LNDK_GRPC_URL=
LNDK_TLS_CERT_PATH=
LNDK_MACAROON_PATH=

# ---------------------------------------------------------------------------
# CORS and networking
# ---------------------------------------------------------------------------
# The merchant dashboard dev server runs on http://localhost:5173. Add it here
# only for local development; keep the allowlist explicit, never "*".
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://cherito.coffee
# Empty means forwarded client-IP headers are ignored. In production, list only
# reverse proxies controlled by the operator.
TRUST_PROXY=

# ---------------------------------------------------------------------------
# Invoice limits
# ---------------------------------------------------------------------------
MIN_INVOICE_SATS=1000
MAX_INVOICE_SATS=10000000
DEFAULT_INVOICE_EXPIRY_SECONDS=900

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_CREATE_INVOICE=10
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH_FAILURES=10
RATE_LIMIT_PAYMENT_LINK_RESOLVE=120
RATE_LIMIT_PAYMENT_LINK_CREATE_IP=20
RATE_LIMIT_PAYMENT_LINK_CREATE_TENANT=100
RATE_LIMIT_PAYMENT_LINK_CREATE_LINK=30
RATE_LIMIT_WEBHOOK_MANAGEMENT=30
RATE_LIMIT_SSE_CONNECTIONS=60

# Bound active Lightning calls, queued calls, and scoped status streams.
PROVIDER_MAX_CONCURRENCY=10
PROVIDER_MAX_QUEUE=100
SSE_MAX_GLOBAL=1000
SSE_MAX_PER_TENANT=20

# ---------------------------------------------------------------------------
# Database (SQLite — use an absolute path in production)
# ---------------------------------------------------------------------------
DATABASE_URL=file:/app/data/cherito-payments.db
SQLITE_BUSY_TIMEOUT_MS=5000
DATABASE_BACKUP_DIR=/app/data/backups

# 32 random bytes in canonical base64. Keep this key outside SQLite.
# Generate it with: openssl rand -base64 32
CHERITO_INTENT_SECRET_KEY=
# For rotation only: comma-separated previous keys. Startup re-encrypts every
# affected row with the active key; remove previous keys after that succeeds.
CHERITO_INTENT_SECRET_PREVIOUS_KEYS=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Idempotency
# ---------------------------------------------------------------------------
IDEMPOTENCY_TTL_SECONDS=86400

# ---------------------------------------------------------------------------
# Payment Intent recovery and reconciliation
# ---------------------------------------------------------------------------
PAYMENT_INTENT_RECOVERY_CONCURRENCY=5
PAYMENT_INTENT_RECONCILIATION_INTERVAL_MS=60000
PAYMENT_INTENT_WATCH_RETRY_BASE_MS=1000
PAYMENT_INTENT_WATCH_RETRY_MAX_MS=60000

# ---------------------------------------------------------------------------
# First-run bootstrap
# Required when starting with an empty database. The generated API key is
# created exclusively at this path (mode 0600) and never printed to stdout.
# ---------------------------------------------------------------------------
BOOTSTRAP_KEY_PATH=
BOOTSTRAP_TENANT_NAME=Default Merchant
