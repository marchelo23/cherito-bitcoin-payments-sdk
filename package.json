{
  "name": "cherito-bitcoin-payments",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm --filter @cherito/bitcoin-sdk run build && pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "eslint .",
    "dev": "pnpm --filter cherito-payments-gateway run dev",
    "db": "pnpm --filter cherito-payments-gateway run db --"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.46.0"
  },
  "engines": {
    "node": ">=22.5",
    "pnpm": ">=10"
  }
}
